def create_meta_dataset(base_model, loader):
    base_model.eval()

    meta_images = []
    meta_labels = []

    with torch.no_grad():
        for images, labels in loader:
            images = images.to(device)
            labels = labels.to(device)

            outputs = base_model(images)
            predictions = outputs.argmax(dim=1)

            correct = (predictions == labels).long()

            meta_images.append(images.cpu())
            meta_labels.append(correct.cpu())

    meta_images = torch.cat(meta_images)
    meta_labels = torch.cat(meta_labels)

    return TensorDataset(meta_images, meta_labels)

