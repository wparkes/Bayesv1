        percent * len(sorted_images)
    )

    top_images = sorted_images[:cutoff].to(device)

    top_labels = sorted_labels[:cutoff].to(device)

    base_model.eval()

    with torch.no_grad():

        outputs = base_model(top_images)

        loss = criterion(
            outputs,
            top_labels
        )

        preds = outputs.argmax(dim=1)

        correct = (
            preds == top_labels
        ).sum().item()

